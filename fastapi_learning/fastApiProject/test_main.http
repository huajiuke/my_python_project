# Test your FastAPI endpoints

GET http://127.0.0.1:8080/
Accept: application/json

###

GET http://127.0.0.1:8080/hello/User
Accept: application/json

###

POST http://127.0.0.1:8080/users/register
Content-Type: application/json

{
  "username": "api_user",
  "password": "secret123",
  "age": 25,
  "email": "api_user@example.com"
}

###

POST http://127.0.0.1:8080/auth/login
Content-Type: application/x-www-form-urlencoded

username=api_user&password=secret123

###

GET http://127.0.0.1:8080/users/me
Authorization: Bearer <替换成登录返回的access_token>

###

GET http://127.0.0.1:8080/news?skip=0&limit=10
Accept: application/json

###

GET http://127.0.0.1:8080/items?page=1&size=10
Accept: application/json

###

POST http://127.0.0.1:8080/items
Content-Type: application/json
Authorization: Bearer <替换成登录返回的access_token>

{
  "name": "Python入门",
  "price": 59.9
}

###

GET http://127.0.0.1:8080/items/1
Accept: application/json

###

GET http://127.0.0.1:8080/json

###

GET http://127.0.0.1:8080/html

###

GET http://127.0.0.1:8080/file

###

GET http://127.0.0.1:8080/redirect

###

POST http://127.0.0.1:8080/send
Content-Type: application/x-www-form-urlencoded

email=test@example.com

###

POST http://127.0.0.1:8080/upload
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="username"

zhangsan
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="hello.txt"
Content-Type: text/plain

hello
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###

GET http://127.0.0.1:8080/static/hello.html
